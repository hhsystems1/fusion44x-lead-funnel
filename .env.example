# =============================================================================
# Fusion 44X Lead Funnel — Environment Variables
# =============================================================================
#
# Instructions:
#   1. Copy this file to .env.local
#   2. Fill in the values for the integrations you enable
#   3. Never commit .env.local or any file containing real secrets
#
# Where variables are stored:
#   [local]     → .env.local                                    (gitignored)
#   [vercel]    → Vercel Project Settings → Environment Variables (production)
#   [supabase]  → Supabase Edge Function secrets                 (edge functions)
# =============================================================================

# ---------------------------------------------------------------------------
# PUBLIC — Browser-safe variables
# ---------------------------------------------------------------------------
# These are prefixed with NEXT_PUBLIC_ and are safe to expose in the browser.
# They are inlined at build time by Next.js.

# [local] [vercel]
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [local] [vercel] [supabase]
NEXT_PUBLIC_SUPABASE_URL=

# [local] [vercel] [supabase]
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [local] [vercel]
NEXT_PUBLIC_META_PIXEL_ID=

# ---------------------------------------------------------------------------
# SERVER-ONLY — Sensitive credentials (never expose to the browser)
# ---------------------------------------------------------------------------
# These variables must never be prefixed with NEXT_PUBLIC_.
# They are accessible only in Server Components, Route Handlers, and lib modules.

# --- Supabase ---
# Required when using getServerClient() or Supabase admin operations.
# [local] [vercel] [supabase]
SUPABASE_SERVICE_ROLE_KEY=

# --- Meta Conversions API ---
# Required when sending server-side conversion events to Meta.
# [local] [vercel]
META_CAPI_ACCESS_TOKEN=

# Optional — enables Meta test events (see Meta Events Manager).
# [local] [vercel]
META_TEST_EVENT_CODE=

# --- Google Calendar ---
# Required when using the Google Calendar booking adapter.
# [local] [vercel]
GOOGLE_CALENDAR_ID=

# [local] [vercel]
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Use single-quoted string or base64 encoding for newline preservation.
# [local] [vercel]
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# --- Email Provider ---
# Required when a provider is connected for sending email notifications.
# [local] [vercel]
EMAIL_PROVIDER=resend
EMAIL_FROM=consultations@fusion44x.com
EMAIL_REPLY_TO=consultations@fusion44x.com
EMAIL_API_KEY=re_xxxxxxxxxxxx

# --- Booking ---
# Timezone for calendar slot display (IANA format).
# [local] [vercel]
BOOKING_TIMEZONE=America/New_York
